<Window x:Class="DeskHush.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DeskHush"
        Icon="Assets/DeskHush.ico"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="84" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="78" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,18,14,10" Orientation="Horizontal">
                    <Border Width="38" Height="38" Background="{StaticResource AccentBrush}" CornerRadius="6">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#FFFFFF" Text="&#xE72E;" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Text="DeskHush" />
                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#99A2A4" Text="安静桌面管理器" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <RadioButton IsChecked="True" Tag="0" Style="{StaticResource NavigationRadio}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Width="28" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE80F;" /><TextBlock Text="概览" /></StackPanel>
                    </RadioButton>
                    <RadioButton Tag="1" Style="{StaticResource NavigationRadio}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Width="28" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE8A7;" /><TextBlock Text="弹窗拦截" /></StackPanel>
                    </RadioButton>
                    <RadioButton Tag="2" Style="{StaticResource NavigationRadio}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Width="28" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE700;" /><TextBlock Text="右键菜单" /></StackPanel>
                    </RadioButton>
                    <RadioButton Tag="3" Style="{StaticResource NavigationRadio}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Width="28" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE768;" /><TextBlock Text="启动项" /></StackPanel>
                    </RadioButton>
                    <RadioButton Tag="4" Style="{StaticResource NavigationRadio}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Width="28" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE713;" /><TextBlock Text="设置" /></StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="24,0,18,16" VerticalAlignment="Bottom">
                    <TextBlock Foreground="#D6DADB" Text="{Binding AdministratorStatus}" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#7F898B" Text="v0.2.1 · Windows x64" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Border Padding="28,0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="SemiBold" Text="概览" />
                        <TextBlock x:Name="PageSummary" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding ProtectionStatus}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="弹窗拦截" />
                        <ToggleButton IsChecked="{Binding IsPopupBlockingEnabled}" Style="{StaticResource SwitchToggle}" ToolTip="开启或暂停弹窗拦截" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="MainTabs" Grid.Row="1" SelectedIndex="0" Background="Transparent" BorderThickness="0" Style="{StaticResource ContentOnlyTabControl}">
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,24,28,28">
                            <UniformGrid Columns="4" Margin="0,0,0,22">
                                <Border Margin="0,0,10,0" Padding="18" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="拦截状态" /><TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding ProtectionStatus}" /></StackPanel>
                                </Border>
                                <Border Margin="4,0,6,0" Padding="18" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="规则" /><TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding RuleCountText}" /></StackPanel>
                                </Border>
                                <Border Margin="6,0,4,0" Padding="18" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="累计处理" /><TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Text="{Binding BlockCountText}" /></StackPanel>
                                </Border>
                                <Border Margin="10,0,0,0" Padding="18" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="启动项" /><TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding StartupCountText}" /></StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                <Border Margin="0,0,10,0" Padding="18" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="最近活动" />
                                        <ListBox Margin="0,12,0,0" MinHeight="230" ItemsSource="{Binding RecentActivity}" BorderThickness="0" Background="Transparent">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,5">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding TimeText}" />
                                                        <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{Binding Title}" /><TextBlock Margin="0,2,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Margin="10,0,0,0" Padding="18" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="系统项目" />
                                        <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="右键菜单" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding ContextCountText}" /></Grid>
                                        <Separator Margin="0,12" Background="{StaticResource BorderBrush}" />
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="启动项" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding StartupCountText}" /></Grid>
                                        <Separator Margin="0,12" Background="{StaticResource BorderBrush}" />
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="权限" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding AdministratorStatus}" /></Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid Margin="28,22,28,24">
                        <Grid.RowDefinitions><RowDefinition Height="3*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                        <Border Margin="0,0,10,0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Margin="14,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="目标窗口" />
                                    <Button Grid.Column="1" Width="108" Click="CaptureWindow_Click" Style="{StaticResource SecondaryButton}" ToolTip="冻结桌面并选择一个窗口">
                                        <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,7,0" FontFamily="Segoe MDL2 Assets" Text="&#xE722;" /><TextBlock Text="桌面抓取" /></StackPanel>
                                    </Button>
                                </Grid>
                                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                                    <TabItem Header="当前窗口">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <Grid Margin="12,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBox Margin="0,0,10,0" VerticalAlignment="Center" Text="{Binding WindowSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="按程序、标题或窗口类筛选" />
                                                <Button Grid.Column="1" Content="&#xE72C;" Command="{Binding RefreshWindowsCommand}" Style="{StaticResource IconButton}" ToolTip="刷新窗口" />
                                                <Button Grid.Column="2" Margin="8,0,0,0" Content="&#xE710;" Command="{Binding AddRuleFromWindowCommand}" Style="{StaticResource IconButton}" ToolTip="从选中窗口创建规则" />
                                            </Grid>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding VisibleWindows}" SelectedItem="{Binding SelectedWindow}" IsReadOnly="True">
                                                <DataGrid.Columns><DataGridTextColumn Width="0.8*" Header="程序" Binding="{Binding ProcessName}" /><DataGridTextColumn Width="1.25*" Header="窗口标题" Binding="{Binding Title}" /><DataGridTextColumn Width="86" Header="尺寸" Binding="{Binding SizeText}" /></DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="窗口记录">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <Grid Margin="12,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding WindowRecordingStatus}" />
                                                    <ToggleButton IsChecked="{Binding IsWindowRecordingEnabled}" Style="{StaticResource SwitchToggle}" ToolTip="后台记录新出现的窗口" />
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center" Text="{Binding WindowRecordSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="筛选窗口记录" />
                                                <Button Grid.Column="2" Content="&#xE74D;" Command="{Binding ClearWindowRecordsCommand}" Style="{StaticResource IconButton}" ToolTip="清空窗口记录" />
                                                <Button Grid.Column="3" Margin="8,0,0,0" Content="&#xE710;" Command="{Binding AddRuleFromRecordCommand}" Style="{StaticResource IconButton}" ToolTip="从选中记录创建规则" />
                                            </Grid>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding WindowRecords}" SelectedItem="{Binding SelectedWindowRecord}" IsReadOnly="True">
                                                <DataGrid.Columns><DataGridTextColumn Width="68" Header="时间" Binding="{Binding TimeText}" /><DataGridTextColumn Width="0.75*" Header="程序" Binding="{Binding ProcessName}" /><DataGridTextColumn Width="1.2*" Header="窗口标题" Binding="{Binding Title}" /><DataGridTextColumn Width="86" Header="尺寸" Binding="{Binding SizeText}" /></DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Margin="10,0,0,0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Margin="14,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="拦截规则" />
                                <DataGrid Grid.Row="1" ItemsSource="{Binding PopupRules}" SelectedItem="{Binding SelectedPopupRuleSource}" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="*" Header="名称" Binding="{Binding Name}" /><DataGridTextColumn Width="105" Header="程序" Binding="{Binding ProcessName}" /><DataGridTextColumn Width="70" Header="命中" Binding="{Binding HitCount}" />
                                        <DataGridTemplateColumn Width="70" Header="启用"><DataGridTemplateColumn.CellTemplate><DataTemplate><ToggleButton IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding DataContext.TogglePopupRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource SwitchToggle}" ToolTip="启用或暂停规则" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0" Padding="16" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0"><TextBlock Margin="0,0,0,6" Foreground="{StaticResource MutedTextBrush}" Text="规则名称" /><TextBox Text="{Binding SelectedPopupRule.Name, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Margin="0,0,0,6" Foreground="{StaticResource MutedTextBrush}" Text="标题匹配" /><TextBox Text="{Binding SelectedPopupRule.TitlePattern, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Margin="0,0,0,6" Foreground="{StaticResource MutedTextBrush}" Text="匹配方式" /><ComboBox SelectedValue="{Binding SelectedPopupRule.TitleMatchMode}" SelectedValuePath="Tag"><ComboBoxItem Tag="Contains" Content="包含" /><ComboBoxItem Tag="Exact" Content="完全相同" /><ComboBoxItem Tag="Wildcard" Content="通配符" /><ComboBoxItem Tag="Regex" Content="正则" /></ComboBox></StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,14,0"><TextBlock Margin="0,0,0,6" Foreground="{StaticResource MutedTextBrush}" Text="动作" /><ComboBox SelectedValue="{Binding SelectedPopupRule.Action}" SelectedValuePath="Tag"><ComboBoxItem Tag="Close" Content="关闭" /><ComboBoxItem Tag="Hide" Content="隐藏" /></ComboBox></StackPanel>
                                <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Orientation="Horizontal"><Button Width="82" Margin="0,0,8,0" Command="{Binding SaveRuleCommand}" Style="{StaticResource PrimaryButton}" Content="保存" /><Button Width="36" Command="{Binding RemoveRuleCommand}" Style="{StaticResource IconButton}" Foreground="{StaticResource DangerBrush}" Content="&#xE74D;" ToolTip="删除规则" /></StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Border Margin="28,22,28,24" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="菜单项" /><TextBox Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding ContextSearchText, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="3" Content="&#xE72C;" Command="{Binding RefreshContextMenuCommand}" Style="{StaticResource IconButton}" ToolTip="刷新菜单项" /></Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding ContextMenuEntries}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="1.1*" Header="名称" Binding="{Binding Name}" /><DataGridTextColumn Width="85" Header="位置" Binding="{Binding Location}" /><DataGridTextColumn Width="100" Header="类型" Binding="{Binding Kind}" /><DataGridTextColumn Width="1.55*" Header="注册表来源" Binding="{Binding RegistryPath}" /><DataGridTextColumn Width="1.2*" Header="命令 / 处理器" Binding="{Binding Command}" />
                                    <DataGridTemplateColumn Width="88" Header="状态"><DataGridTemplateColumn.CellTemplate><DataTemplate><ToggleButton IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding DataContext.ToggleContextMenuCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource SwitchToggle}" ToolTip="启用或禁用菜单项" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem>
                    <Border Margin="28,22,28,24" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="启动项" /><TextBox Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding StartupSearchText, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="3" Content="&#xE72C;" Command="{Binding RefreshStartupCommand}" Style="{StaticResource IconButton}" ToolTip="刷新启动项" /></Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding StartupEntries}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="1*" Header="名称" Binding="{Binding Name}" /><DataGridTextColumn Width="100" Header="类型" Binding="{Binding Kind}" /><DataGridTextColumn Width="1.45*" Header="来源" Binding="{Binding SourcePath}" /><DataGridTextColumn Width="1.55*" Header="命令" Binding="{Binding Command}" />
                                    <DataGridTemplateColumn Width="88" Header="状态"><DataGridTemplateColumn.CellTemplate><DataTemplate><ToggleButton IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource SwitchToggle}" ToolTip="启用或禁用启动项" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,22,28,28" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="常规" />
                            <Border Margin="0,12,0,24" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <Grid Height="58" Margin="16,0"><TextBlock VerticalAlignment="Center" Text="开机启动" /><ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding StartWithWindows}" Style="{StaticResource SwitchToggle}" ToolTip="随 Windows 登录启动" /></Grid>
                                    <Separator Margin="16,0" Background="{StaticResource BorderBrush}" />
                                    <Grid Height="58" Margin="16,0"><TextBlock VerticalAlignment="Center" Text="关闭窗口时最小化到托盘" /><ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding MinimizeToTray}" Style="{StaticResource SwitchToggle}" ToolTip="保持后台拦截运行" /></Grid>
                                    <Separator Margin="16,0" Background="{StaticResource BorderBrush}" />
                                    <Grid Height="58" Margin="16,0"><TextBlock VerticalAlignment="Center" Text="管理员权限" /><Button Width="142" HorizontalAlignment="Right" Command="{Binding RestartElevatedCommand}" Style="{StaticResource SecondaryButton}" Content="以管理员身份重启" /></Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="更新" />
                            <Border Margin="0,12,0,24" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <Grid Height="58" Margin="16,0"><TextBlock VerticalAlignment="Center" Text="自动检查新版本" /><ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding CheckForUpdatesEnabled}" Style="{StaticResource SwitchToggle}" ToolTip="每天检查一次 GitHub Release" /></Grid>
                                    <Separator Margin="16,0" Background="{StaticResource BorderBrush}" />
                                    <Grid MinHeight="66" Margin="16,0">
                                        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding CurrentVersionText}" /><TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding UpdateStatusText}" /></StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Button Width="92" Margin="0,0,8,0" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource SecondaryButton}" Content="检查更新" />
                                            <Button Width="102" Command="{Binding OpenUpdateCommand}" Style="{StaticResource PrimaryButton}" Content="查看新版本" Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="数据" />
                            <Border Margin="0,12,0,24" Padding="16" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <Grid><TextBlock VerticalAlignment="Center" Text="规则、备份与操作记录" /><Button Width="112" HorizontalAlignment="Right" Command="{Binding OpenDataDirectoryCommand}" Style="{StaticResource SecondaryButton}"><StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,7,0" FontFamily="Segoe MDL2 Assets" Text="&#xE838;" /><TextBlock Text="打开目录" /></StackPanel></Button></Grid>
                            </Border>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="关于" />
                            <Border Margin="0,12,0,0" Padding="16" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock FontSize="16" FontWeight="SemiBold" Text="DeskHush 0.2.1" /><TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" Text="MIT License" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Windows 10 / 11 · x64" /></Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Padding="14,0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid><TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" /><ProgressBar Width="88" Height="3" HorizontalAlignment="Right" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid>
        </Border>
    </Grid>
</Window>
